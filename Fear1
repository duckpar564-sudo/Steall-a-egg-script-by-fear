-- ===== FUNÇÃO DE CRIAR BOTÃO =====
local function makeBtn(name, scriptUrl, order)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 55)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    btn.LayoutOrder = order
    btn.Parent = ButtonHolder

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(55, 55, 80)
    stroke.Thickness = 1
    stroke.Parent = btn

    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0, 4, 1, -16)
    accent.Position = UDim2.new(0, 8, 0, 8)
    accent.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    accent.BorderSizePixel = 0
    accent.Parent = btn

    local accentCorner = Instance.new("UICorner")
    accentCorner.CornerRadius = UDim.new(1, 0)
    accentCorner.Parent = accent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -50, 0, 20)
    label.Position = UDim2.new(0, 22, 0, 10)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = btn

    local sub = Instance.new("TextLabel")
    sub.Size = UDim2.new(1, -50, 0, 14)
    sub.Position = UDim2.new(0, 22, 0, 30)
    sub.BackgroundTransparency = 1
    sub.Text = "Clique para executar"
    sub.TextColor3 = Color3.fromRGB(150, 150, 170)
    sub.Font = Enum.Font.Gotham
    sub.TextSize = 11
    sub.TextXAlignment = Enum.TextXAlignment.Left
    sub.Parent = btn

    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 75)
        stroke.Color = Color3.fromRGB(255, 60, 60)
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
        stroke.Color = Color3.fromRGB(55, 55, 80)
    end)

    btn.MouseButton1Down:Connect(function()
        btn.Size = UDim2.new(1, -6, 0, 52)
    end)
    btn.MouseButton1Up:Connect(function()
        btn.Size = UDim2.new(1, 0, 0, 55)
    end)

    btn.MouseButton1Click:Connect(function()
        sub.Text = "Carregando..."
        sub.TextColor3 = Color3.fromRGB(255, 150, 150)
        task.spawn(function()
            local ok = pcall(function()
                loadstring(game:HttpGet(scriptUrl))()
            end)
            if ok then
                sub.Text = "✓ Executado"
                sub.TextColor3 = Color3.fromRGB(100, 255, 150)
            else
                sub.Text = "✗ Erro ao carregar"
                sub.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
            task.wait(2)
            sub.Text = "Clique para executar"
            sub.TextColor3 = Color3.fromRGB(150, 150, 170)
        end)
    end)
end

